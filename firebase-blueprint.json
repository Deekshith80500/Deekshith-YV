{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about a patient or doctor.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "age": { "type": "string" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "address": { "type": "string" },
        "degree": { "type": "string" },
        "isSharingEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "MedicalRecord": {
      "title": "Medical Record",
      "description": "A prescription or report uploaded by a patient.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "fileURL": { "type": "string" },
        "type": { "type": "string", "enum": ["prescription", "report"] },
        "fileName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "fileURL", "type", "createdAt"]
    },
    "Reminder": {
      "title": "Health Reminder",
      "description": "A pill or checkup reminder.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "days": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "time"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles for patients and doctors."
    },
    "records/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Uploaded medical records."
    },
    "reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "Health reminders for patients."
    }
  }
}
