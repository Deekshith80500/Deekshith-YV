rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /records/{userId}/{fileName} {
      function isSignedIn() {
        return request.auth != null;
      }
      
      function isOwner(uid) {
        return isSignedIn() && request.auth.uid == uid;
      }

      function canDoctorView(uid) {
        return isSignedIn() && firestore.get(/databases/(default)/documents/users/$(uid)).data.isSharingEnabled == true;
      }

      allow read: if isOwner(userId) || canDoctorView(userId);
      allow write: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }
  }
}
